{
  "name": "Weather Example - First Steps",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Start Here",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.open-meteo.com/v1/forecast?latitude=40.4168&longitude=-3.7038&current=temperature_2m,wind_speed_10m&timezone=auto"
      },
      "id": "http-request",
      "name": "Fetch Madrid Weather",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "jsCode": "// The HTTP node gives you the raw JSON in the `json` property.\n// Here we pull out the bits we care about and build a readable message.\nconst current = $input.item.json.current;\nconst units = $input.item.json.current_units;\n\nconst message = [\n  `Temperature: ${current.temperature_2m}${units.temperature_2m}`,\n  `Wind: ${current.wind_speed_10m}${units.wind_speed_10m}`,\n  `Updated: ${current.time}`,\n].join('\\n');\n\nreturn { json: { message, current } };"
      },
      "id": "code-format",
      "name": "Format Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0]
    }
  ],
  "connections": {
    "Start Here": {
      "main": [
        [
          {
            "node": "Fetch Madrid Weather",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Madrid Weather": {
      "main": [
        [
          {
            "node": "Format Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
