          }
        ]
      ]
    },
    "Upload Invoice": {
      "main": [
        [
          {
            "node": "Add Invoice Backup Label",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Add Invoice Backup Label": {
      "main": [
        [
          {
            "node": "Mark as Read",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
